# --- CORS ---
CORS_ORIGINS=http://localhost:5173,https://your-production-client.example.com

# --- Admin access (no login system — a single shared secret) ---
# Your generated admin key. Keep it secret; enter it once in the client's
# /authority page.
ADMIN_KEY=1jj5CTJRCCZHm7DruxTZkqUOa1q1qvKX

# --- Supabase (same variables notifications.py already reads) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NOTIFICATION_FROM_EMAIL=notifications@drainforge.example

# Copy this file to .env in the same folder (api/.env) — main.py now calls
# load_dotenv() on startup, so a .env file here is read automatically. If
# you'd rather export real shell/host environment variables instead, that
# works too and takes precedence.
#
# Run supabase_schema.sql once against your project, and create a PUBLIC
# storage bucket named "report-evidence" (Storage -> New bucket -> Public).
#
# If SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY aren't set, the API
# automatically falls back to an in-memory demo dataset (3 seeded reports)
# so it still runs locally without a live project.
